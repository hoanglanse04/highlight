# Application URLs (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Server-only secret used by authenticated Payload draft preview routes.
PREVIEW_SECRET=replace-with-an-independent-long-random-secret

# Used by host-based development. Docker Compose overrides the host to `postgres`.
DATABASE_URI=postgresql://highlight:replace-with-a-strong-password@localhost:5432/highlight

# PostgreSQL container
POSTGRES_DB=highlight
POSTGRES_USER=highlight
POSTGRES_PASSWORD=replace-with-a-strong-password

# Production VPS path. For local Docker development, use ./uploads instead.
UPLOADS_HOST_PATH=/var/www/highlight-media/uploads

# Caddy / DNS
DOMAIN=example.com
CADDY_EMAIL=admin@example.com

# One-account administrator seeder. Keep the real password outside source control.
ADMIN_EMAIL=admin@highlightmedia.vn
ADMIN_NAME=Highlight Admin
ADMIN_PASSWORD=

# Optional, production-safe content seeder controls. The default creates drafts,
# skips existing content, and never overwrites editor changes.
SEED_DRY_RUN=false
SEED_FORCE=false
SEED_PUBLISH=false

# Verified Highlight Media business details. Leave unknown values empty.
HIGHLIGHT_LEGAL_NAME=
HIGHLIGHT_EMAIL=
HIGHLIGHT_PHONE=
HIGHLIGHT_ADDRESS_VI=
HIGHLIGHT_ADDRESS_EN=

# Official Highlight Media social URLs only.
HIGHLIGHT_FACEBOOK_URL=
HIGHLIGHT_INSTAGRAM_URL=
HIGHLIGHT_TIKTOK_URL=
HIGHLIGHT_YOUTUBE_URL=
HIGHLIGHT_VIMEO_URL=
HIGHLIGHT_LINKEDIN_URL=
HIGHLIGHT_BEHANCE_URL=

# Payload Media IDs and optional external Hero video URL.
HIGHLIGHT_HERO_VIDEO_URL=
HIGHLIGHT_HERO_MEDIA_ID=
HIGHLIGHT_HERO_POSTER_MEDIA_ID=

# Enable Homepage statistics only when all three verified values are supplied.
HIGHLIGHT_YEARS_EXPERIENCE=
HIGHLIGHT_PROJECTS_DELIVERED=
HIGHLIGHT_CLIENTS_COUNT=
